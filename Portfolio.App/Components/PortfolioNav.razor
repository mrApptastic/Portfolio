@inject IStringLocalizer<AppStrings> Loc
@inject IJSRuntime JS
@inject NavigationManager Nav

<nav class="portfolio-nav @(isScrolled ? "scrolled" : "")">
    <div class="nav-brand">
        <a href="/" class="brand-link">mrApptastic</a>
    </div>
    <button class="nav-toggle @(menuOpen ? "open" : "")" @onclick="ToggleMenu" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
    </button>
    <div class="nav-links @(menuOpen ? "open" : "")">
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMenu">@Loc["Nav_Home"]</NavLink>
        <NavLink href="/about" @onclick="CloseMenu">@Loc["Nav_About"]</NavLink>
        <NavLink href="/cv" @onclick="CloseMenu">@Loc["Nav_CV"]</NavLink>
        <NavLink href="/projects" @onclick="CloseMenu">@Loc["Nav_Projects"]</NavLink>
        <NavLink href="/contact" @onclick="CloseMenu">@Loc["Nav_Contact"]</NavLink>
        <div class="lang-selector">
            <button class="lang-btn @(currentLang == "da" ? "active" : "")" @onclick='() => SetLanguage("da")' title="Dansk">🇩🇰</button>
            <button class="lang-btn @(currentLang == "en" ? "active" : "")" @onclick='() => SetLanguage("en")' title="English">🇬🇧</button>
            <button class="lang-btn @(currentLang == "sv" ? "active" : "")" @onclick='() => SetLanguage("sv")' title="Svenska">🇸🇪</button>
        </div>
    </div>
</nav>

@code {
    private bool menuOpen = false;
    private bool isScrolled = false;
    private string currentLang = "da";

    protected override async Task OnInitializedAsync()
    {
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "portfolio-culture");
        currentLang = stored ?? "da";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.portfolioApp.initScrollWatcher", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void OnScroll(bool scrolled)
    {
        isScrolled = scrolled;
        StateHasChanged();
    }

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;

    private async Task SetLanguage(string lang)
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "portfolio-culture", lang);
        await JS.InvokeVoidAsync("location.reload");
    }
}
