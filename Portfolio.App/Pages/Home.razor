@page "/"
@inject IStringLocalizer<AppStrings> Loc
@inject IPortfolioService PortfolioSvc
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Henrik Beske — @Loc["Home_Title"]</PageTitle>

<section class="hero-section">
    <canvas id="oldTerminal" data-intro-lines="@IntroLinesJson"></canvas>
    <script src="js/intro.js"></script>
</section>

@code {
    private string IntroLinesJson => System.Text.Json.JsonSerializer.Serialize(new[]
    {
        Loc["Home_Greeting"].Value,
        Loc["Home_Welcome"].Value,
        Loc["Home_LookAround"].Value,
        Loc["Home_Tagline"].Value,
        string.Empty,
        Loc["Home_ASCII_Reward"].Value,
        string.Empty,
        "           ,-~~-.___.",
        "          / ()=(()   \\",
        "         (   (        0",
        "          \\._\\, ,----'",
        "     ##XXXxxxxxxx",
        "            /  ---'~;",
        "           /    /~|-",
        "         =(   ~~  |",
        "   /~~~~~~~~~~~~~~~~~~~~~\\",
        "  /_______________________\\",
        " /_________________________\\",
        "/___________________________\\ ",
        "   |____________________|",
        "   |____________________|",
        "   |____________________|",
        "   |                    |",
        "    "
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initIntroTerminal");
    }
}

