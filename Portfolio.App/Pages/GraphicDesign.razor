@page "/graphic-design"
@inject IStringLocalizer<AppStrings> Loc

<PageTitle>@Loc["Nav_GraphicDesign"] — Henrik Beske</PageTitle>

<section class="graphic-design-section">
    <div class="section-container">
        <h1 class="section-title">@Loc["GraphicDesign_Title"]</h1>
        <p class="graphic-intro">@Loc["GraphicDesign_Intro"]</p>

        @* <div class="design-placeholder-note">
            <span class="design-note-icon">🎨</span>
            <span>@Loc["GraphicDesign_PlaceholderNote"]</span>
        </div> *@

        <div class="design-grid">
            @foreach (var design in Designs)
            {
                <article class="design-card">
                    <a href="@design.FullDesignUrl" target="_blank" rel="noopener" class="design-image-link">
                        <img src="@design.ImageUrl" alt="@Loc[design.TitleKey]" class="design-image" />
                    </a>
                    <div class="design-card-content">
                        <p class="design-tool">@design.Tool</p>
                        <h3>@Loc[design.TitleKey]</h3>
                        <p class="design-description">@Loc[design.DescriptionKey]</p>
                        <a href="@design.FullDesignUrl" target="_blank" rel="noopener" class="design-open-link">
                            @Loc["GraphicDesign_LinkOpen"] ↗
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

