@page "/hobby-projects"
@inject IStringLocalizer<AppStrings> Loc

<PageTitle>@Loc["Nav_HobbyProjects"] — Henrik Beske</PageTitle>

<section class="hobby-lab-section">
    <div class="section-container">
        <h1 class="section-title">@Loc["HobbyProjects_Title"]</h1>
        <p class="hobby-intro">@Loc["HobbyProjects_Intro"]</p>

        @* <div class="hobby-placeholder-note">
            <span class="hobby-note-dot"></span>
            <span>@Loc["HobbyProjects_PlaceholderNote"]</span>
        </div> *@

        <div class="hobby-grid">
            @foreach (var project in hobbyProjects)
            {
                <article class="hobby-card">
                    <div class="hobby-image-wrap">
                        @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                        {
                            <a href="@project.DemoUrl" target="_blank" rel="noopener" class="hobby-image-link">
                                <img src="@project.ImageUrl" alt="@Loc[project.NameKey]" class="hobby-image" />
                            </a>
                        }
                    </div>
                    <div class="hobby-card-content">
                        <p class="hobby-status">@Loc[project.StatusKey]</p>
                        <h3>@Loc[project.NameKey]</h3>
                        <p class="hobby-description">@Loc[project.DescriptionKey]</p>
                        <div class="hobby-tags">
                            @foreach (var tag in project.Tags)
                            {
                                <span>@Loc[tag]</span>
                            }
                        </div>
                        <div class="hobby-links">
                            <a href="@project.DemoUrl" target="_blank" rel="noopener"
                               class="link-badge demo">@Loc["HobbyProjects_LinkDemo"]</a>
                            <a href="@project.RepositoryUrl" target="_blank" rel="noopener"
                               class="link-badge source">@Loc["HobbyProjects_LinkRepository"]</a>
                            @if (!string.IsNullOrWhiteSpace(project.DetailsUrl))
                            {
                                <a href="@project.DetailsUrl" target="_blank" rel="noopener"
                                   class="link-badge docs">@Loc["HobbyProjects_LinkDetails"]</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

